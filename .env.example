# Optional local runtime: XAI_API_KEY is required locally.
# Optional model override; saved into each immutable run snapshot.
XAI_MODEL=
LOCAL_DATA_DIR=

# Default Convex-backed website and authenticated HTTP MCP settings.
# Credential inventory. Fill .env.local locally; never commit real values.
# Set Convex action secrets in Convex and MCP secrets in Render separately.
# VITE_* values are public and embedded in the website build.

# Public URLs and deployment configuration
MCP_PUBLIC_URL=
WEB_PUBLIC_URL=
CONVEX_DEPLOYMENT=
CONVEX_URL=
VITE_CONVEX_URL=
VITE_MCP_URL=

# Convex deployment/CI only; never an application identity
CONVEX_DEPLOY_KEY=

# Convex Auth: configure these on the Convex deployment (not the browser).
# Generate the signing pair through official Convex Auth setup; do not rotate casually.
JWT_PRIVATE_KEY=
JWKS=
# Needed for redirects when OAuth/email login is added; passwords do not require it.
SITE_URL=
# CONVEX_SITE_URL is supplied automatically inside Convex; set its public URL in Render.
CONVEX_SITE_URL=

# Selected OAuth integration: WorkOS Standalone Connect + existing Convex login.
# Set MCP_AUTH_PROVIDER to workos. External legacy settings below are unused in this mode.
MCP_AUTH_PROVIDER=
WORKOS_AUTHKIT_ISSUER=
# Convex only: never put this key in the website or Render MCP process.
WORKOS_API_KEY=
# Shared between Render and Convex; restricted token-exchange client credential.
MCP_BRIDGE_CLIENT_ID=
MCP_BRIDGE_CLIENT_SECRET=
# Convex only; separate from website auth signing keys.
MCP_BRIDGE_PRIVATE_KEY=
MCP_BRIDGE_KEY_ID=
MCP_BRIDGE_JWKS=

# Hosted MCP resource URL and optional legacy external provider settings.
MCP_RESOURCE_URL=
MCP_AUTH_ISSUER=
MCP_AUTH_JWKS_URL=
MCP_TOKEN_EXCHANGE_URL=
MCP_TOKEN_EXCHANGE_CLIENT_ID=
MCP_TOKEN_EXCHANGE_CLIENT_SECRET=
MCP_CONVEX_AUDIENCE=
MCP_CONVEX_ISSUER=
MCP_CONVEX_JWKS_URL=
MCP_ALLOWED_ORIGINS=

# Grok: set both on the Convex deployment, never in VITE_* or Render.
# LIVE_ANALYSIS_ENABLED=true permits paid analysis of uploaded documents;
# anything else keeps it off (start, resume, and each new step check it).
XAI_API_KEY=
LIVE_ANALYSIS_ENABLED=
# Convex deployment only. DEMO_OPEN_ACCESS=true lets unauthenticated callers act
# as one shared demo actor (its own workspace only). Local demos; see docs/DEMO.md.
DEMO_OPEN_ACCESS=

# Optional future providers/infrastructure; currently unused
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
DOCUMENT_WORKER_SERVICE_SECRET=
RENDER_API_KEY=
