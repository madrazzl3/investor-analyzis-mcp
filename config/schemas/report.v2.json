{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "report@2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings", "coverage", "requestedMaterials"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "statement",
          "severity",
          "evidence",
          "alternativeExplanation",
          "followUpQuestion",
          "disposition",
          "verificationNote"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "category": {
            "enum": [
              "metric_consistency",
              "cross_document",
              "timeline",
              "unsupported_claim",
              "other"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "severity": {
            "enum": ["critical", "high", "medium", "low"]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["documentVersionId", "quote", "page"],
              "properties": {
                "documentVersionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "page": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "alternativeExplanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "followUpQuestion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "disposition": {
            "enum": ["verified", "unresolved", "rejected"]
          },
          "verificationNote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      }
    },
    "coverage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "requestedMaterials": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  }
}
