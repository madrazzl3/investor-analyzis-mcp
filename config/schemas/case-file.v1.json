{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "case-file@1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "materialQuality",
    "whatWeKnow",
    "claims",
    "contradictionsAndGaps",
    "flags",
    "coverage"
  ],
  "properties": {
    "materialQuality": {
      "enum": ["sparse", "adequate", "rich"]
    },
    "whatWeKnow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "companyName",
        "product",
        "intendedUsers",
        "businessModel",
        "stage"
      ],
      "properties": {
        "companyName": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "product": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            {
              "type": "null"
            }
          ]
        },
        "intendedUsers": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        },
        "businessModel": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        },
        "stage": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "topic", "text", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "topic": {
            "enum": [
              "market",
              "regulatory",
              "competition",
              "team",
              "traction",
              "business_model",
              "moat",
              "financials",
              "cap_table",
              "product_tech",
              "trust_safety",
              "exit",
              "other"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["documentVersionId", "quote", "page"],
              "properties": {
                "documentVersionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "page": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "contradictionsAndGaps": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "issue",
          "source",
          "questionsForFounder",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "issue": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "questionsForFounder": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "evidence": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["documentVersionId", "quote", "page"],
              "properties": {
                "documentVersionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "page": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appearsToBeTest", "other"],
      "properties": {
        "appearsToBeTest": {
          "type": "boolean"
        },
        "other": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "coverage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  }
}
