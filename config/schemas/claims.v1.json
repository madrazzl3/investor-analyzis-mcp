{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "claims@1.0.0",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "text", "evidence"],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "text": {
        "type": "string",
        "minLength": 1
      },
      "evidence": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["documentVersionId", "quote", "page"],
          "properties": {
            "documentVersionId": {
              "type": "string",
              "minLength": 1
            },
            "quote": {
              "type": "string",
              "minLength": 1
            },
            "page": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
