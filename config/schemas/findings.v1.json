{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "findings@1.0.0",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "statement",
      "severity",
      "evidence",
      "alternativeExplanation"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "statement": {
        "type": "string",
        "minLength": 1
      },
      "severity": {
        "enum": ["critical", "high", "medium", "low"]
      },
      "evidence": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["documentVersionId", "quote", "page"],
          "properties": {
            "documentVersionId": {
              "type": "string",
              "minLength": 1
            },
            "quote": {
              "type": "string",
              "minLength": 1
            },
            "page": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "alternativeExplanation": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
