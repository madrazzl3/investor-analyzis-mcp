{
  "name": "@investor/mcp-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsup --watch --onSuccess \"node --env-file-if-exists=../../.env.local dist/index.js\"",
    "build": "tsup --clean",
    "start": "node dist/index.js",
    "start:local": "node dist/stdio.js",
    "dev:local": "node --import tsx src/stdio.ts"
  },
  "dependencies": {
    "@investor/contracts": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "convex": "1.45.0",
    "jose": "^6.2.12",
    "zod": "^4.6.2"
  }
}
